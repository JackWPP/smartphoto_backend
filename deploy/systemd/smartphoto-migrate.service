[Unit]
Description=SmartPhoto Backend Alembic Migration
After=network-online.target docker.service
Wants=network-online.target

[Service]
Type=oneshot
User=smartphoto
Group=smartphoto
WorkingDirectory=/opt/smartphoto_backend/repo
EnvironmentFile=/opt/smartphoto_backend/shared/.env.prod.native
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/smartphoto_backend/repo/.venv/bin/alembic upgrade head

[Install]
WantedBy=multi-user.target
