APP_NAME=smartphoto-backend
APP_ENV=dev
API_PREFIX=/api/v2
ADMIN_API_PREFIX=/api/admin/v1
DATABASE_URL=postgresql+psycopg://smartphoto:smartphoto@localhost:5432/smartphoto
ADMIN_DATABASE_URL=sqlite:///./storage/admin.sqlite3
REDIS_URL=redis://localhost:6379/0
STORAGE_ROOT=./storage
PUBLIC_BASE_URL=http://localhost:8000
TEST_USER_ID=00000000-0000-0000-0000-000000000001
TASKS_EAGER=false
ADMIN_JWT_SECRET=smartphoto-admin-dev-secret
ADMIN_ACCESS_TOKEN_EXP_MINUTES=120
ADMIN_REFRESH_TOKEN_EXP_DAYS=14
WHATAI_API_BASE=https://api.whatai.cc
WHATAI_API_KEY=
WHATAI_CHAT_MODEL=gpt-4.1-mini
WHATAI_IMAGE_MODEL=gpt-image-1
WHATAI_PARAMETER_MODEL=gemini-3.1-flash-lite-preview
GENERATION_LOCK_TTL_SECONDS=600
