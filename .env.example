APP_NAME=smartphoto-backend
APP_ENV=dev
API_PREFIX=/api/v2
ADMIN_API_PREFIX=/api/admin/v1
DATABASE_URL=postgresql+psycopg://smartphoto:smartphoto@localhost:5432/smartphoto
ADMIN_DATABASE_URL=sqlite:///./storage/admin.sqlite3
REDIS_URL=redis://localhost:6379/0
STORAGE_ROOT=./storage
PUBLIC_BASE_URL=http://localhost:8000
CORS_ALLOW_ORIGINS=
STORAGE_BACKEND=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false
S3_SIGNED_URL_TTL_SECONDS=900
S3_PRESIGN_UPLOAD_TTL_SECONDS=900
S3_PREFIX_UPLOADS=uploads
S3_PREFIX_GENERATED=generated
TEST_USER_ID=00000000-0000-0000-0000-000000000001
TASKS_EAGER=false
ALLOW_DEV_AUTH_BYPASS=true
USER_JWT_SECRET=smartphoto-user-dev-secret
USER_ACCESS_TOKEN_EXP_MINUTES=120
USER_REFRESH_TOKEN_EXP_DAYS=14
ADMIN_JWT_SECRET=smartphoto-admin-dev-secret
ADMIN_ACCESS_TOKEN_EXP_MINUTES=120
ADMIN_REFRESH_TOKEN_EXP_DAYS=14
WHATAI_API_BASE=https://api.whatai.cc
WHATAI_API_KEY=
WHATAI_CHAT_MODEL=gpt-4.1-mini
WHATAI_ANALYSIS_MODEL=gemini-3-pro-preview-thinking-high
WHATAI_PLANNER_MODEL=kimi-k2.5
WHATAI_IMAGE_MODEL=gemini-3.1-flash-image-preview-2k
WHATAI_PARAMETER_MODEL=gemini-3-flash-preview
WHATAI_REQUEST_TIMEOUT_SECONDS=90
WHATAI_IMAGE_EDIT_TIMEOUT_SECONDS=120
WHATAI_PLANNER_LIGHT_MODEL=gemini-3-flash-preview
PLANNER_PROFILE=harness_first
LLM_ROUTE_PLANNER_LIGHT=whatai_gemini
PLANNER_FALLBACK_ROUTE=whatai_gemini
LLM_PROVIDER=openrouter
LLM_ROUTE_ANALYSIS=whatai_gemini
LLM_ROUTE_MAIN_PLANNER=whatai_gemini
LLM_ROUTE_DETAIL_PLANNER=whatai_gemini
LLM_ROUTE_PARAMETER_VISUAL=whatai_gemini
LLM_ROUTE_MAIN_COPY_DESIGN=disabled
LLM_ROUTE_DETAIL_COPY_REVIEW=openrouter_text
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
OPENROUTER_MAIN_PLANNER_MODEL=moonshotai/kimi-k2.5
OPENROUTER_DETAIL_PLANNER_MODEL=moonshotai/kimi-k2.5
OPENROUTER_PLANNER_LIGHT_MODEL=moonshotai/kimi-k2.5
LLM_ANALYSIS_MODEL=deepseek/deepseek-v3.2
LLM_MAIN_PLANNER_MODEL=deepseek/deepseek-v3.2
LLM_DETAIL_PLANNER_MODEL=minimax/minimax-m2.7
LLM_PARAMETER_MODEL=deepseek/deepseek-v3.2
LLM_FALLBACK_MODEL=deepseek/deepseek-v3.2
OPENROUTER_PARAMETER_COMPLETION_MODEL=deepseek/deepseek-v3.2
OPENROUTER_MAIN_COPY_DESIGN_MODEL=minimax/minimax-m2.7
OPENROUTER_DETAIL_COPY_REVIEW_MODEL=minimax/minimax-m2.7
GENERATION_LOCK_TTL_SECONDS=600
MAIN_GENERATION_CONCURRENCY=4
DETAIL_GENERATION_CONCURRENCY=6
GENERATION_SUBMIT_CONCURRENCY=6
IMAGE_SUBMIT_BATCH_SIZE=5
IMAGE_SUBMIT_BATCH_INTERVAL_SECONDS=5
IMAGE_POLL_INITIAL_DELAY_SECONDS=45
IMAGE_TASK_TIMEOUT_SECONDS=450
IMAGE_POLL_PROFILE=[{"interval_seconds":10,"attempts":6},{"interval_seconds":15,"attempts":8},{"interval_seconds":20,"attempts":10}]
CREDIT_PRICING_RULES={"generate_gallery":{"credits":10,"description":"主图整组生成"},"generate_detail_page":{"credits":16,"description":"详情页整组生成"},"global_edit":{"credits":8,"description":"主图全局修改"},"regenerate_asset":{"credits":3,"description":"单张主图重生成"},"regenerate_detail_panel":{"credits":4,"description":"单张详情页 panel 重生成"},"regenerate_gallery":{"credits":10,"description":"主图整组重生成"}}
