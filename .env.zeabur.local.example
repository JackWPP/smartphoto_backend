# =============================================================================
# Zeabur 本地模拟环境变量
# =============================================================================
# 用法: 复制为 .env.zeabur.local 并填入实际的 API Keys
#   cp .env.zeabur.local.example .env.zeabur.local
#
# 然后启动:
#   docker compose -f docker-compose.yml -f docker-compose.zeabur.yml up -d --build
#
# 下面 POSTGRES_* 和 REDIS_* 模拟 Zeabur 自动注入的变量，
# 用于测试 config.py 的 Zeabur 自动检测路径。
# 值与 docker-compose.yml 中定义的 postgres/redis 服务一致。
# =============================================================================

# --- 模拟 Zeabur PostgreSQL 注入 ---
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DATABASE=smartphoto
POSTGRES_USERNAME=smartphoto
POSTGRES_PASSWORD=smartphoto

# --- 模拟 Zeabur Redis 注入 ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- 基础配置 ---
APP_NAME=smartphoto-backend
APP_ENV=prod
API_PREFIX=/api/v2
ADMIN_API_PREFIX=/api/admin/v1
PUBLIC_BASE_URL=http://localhost:8080
CORS_ALLOW_ORIGINS=http://localhost:5173

# --- 安全配置 ---
USER_JWT_SECRET=local-test-user-secret
ADMIN_JWT_SECRET=local-test-admin-secret
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=admin123
ALLOW_DEV_AUTH_BYPASS=false

# --- 图片 SaaS ---
IMAGE_SAAS_DEFAULT_APP_ID=default
IMAGE_SAAS_APP_KEYS=["default:local-test-key"]

# --- AI API Keys (填入你的实际 Key) ---
WHATAI_API_BASE=https://api.aicodemirror.com
WHATAI_API_KEY=sk-your-key
IMAGE_API_BASE=https://www.aiartmirror.com
IMAGE_API_KEY=sk-your-key
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=sk-or-v1-your-key
DOUBAO_API_BASE=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_API_KEY=your-key
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=sk-your-key
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=sk-your-key

# --- LLM 路由 ---
LLM_PROVIDER=whatai
LLM_ROUTE_ANALYSIS=qwen_text
LLM_ROUTE_MAIN_PLANNER=deepseek_text
LLM_ROUTE_DETAIL_PLANNER=deepseek_text
LLM_ROUTE_PARAMETER_VISUAL=whatai_gemini
LLM_ROUTE_PARAMETER_COMPLETION=deepseek_text
LLM_ROUTE_MAIN_COPY_DESIGN=deepseek_text
LLM_ROUTE_DETAIL_COPY_REVIEW=disabled
LLM_ROUTE_TEXT_REVIEW=deepseek_text
PLANNER_FALLBACK_ROUTE=whatai_gemini

# --- 存储 (本地测试用 local, 线上用 s3) ---
STORAGE_BACKEND=local

# --- 生成并发 ---
TASKS_EAGER=false
GENERATION_LOCK_TTL_SECONDS=600
MAIN_GENERATION_CONCURRENCY=2
DETAIL_GENERATION_CONCURRENCY=3
GENERATION_SUBMIT_CONCURRENCY=3
DETAIL_GENERATION_SUBMIT_CONCURRENCY=2
