# =============================================================================
# Zeabur 部署环境变量参考
# =============================================================================
# 在 Zeabur 控制台中为每个 Service 设置环境变量。
#
# 架构概览:
#   - PostgreSQL  (Zeabur 托管服务, 自动注入 POSTGRES_* 变量)
#   - Redis       (Zeabur 托管服务, 自动注入 REDIS_* 变量)
#   - API Service (Dockerfile, SERVICE_TYPE=api)
#   - Worker Service (Dockerfile, SERVICE_TYPE=worker)
#
# 标记说明:
#   [自动注入] = Zeabur 添加数据库服务后自动注入，无需手动设置
#   [必填]     = 必须手动设置
#   [建议]     = 强烈建议手动设置覆盖默认值
#   [可选]     = 有默认值，按需覆盖
# =============================================================================

# =============================================================================
# 数据库连接 - Zeabur 自动注入
# =============================================================================
# POSTGRES_HOST          [自动注入] 由 Zeabur PostgreSQL 服务自动提供
# POSTGRES_PORT          [自动注入]
# POSTGRES_DATABASE      [自动注入]
# POSTGRES_USERNAME      [自动注入]
# POSTGRES_PASSWORD      [自动注入]
# REDIS_HOST             [自动注入] 由 Zeabur Redis 服务自动提供
# REDIS_PORT             [自动注入]
# REDIS_PASSWORD         [自动注入]
# PORT=8080              [自动注入] 服务端口
#
# 无需手动设置 DATABASE_URL 和 REDIS_URL，
# config.py 会自动从上述 Zeabur 变量构建连接串。

# =============================================================================
# 基础配置 [必填 - API Service 和 Worker Service 都需要]
# =============================================================================
APP_NAME=smartphoto-backend
APP_ENV=prod
API_PREFIX=/api/v2
ADMIN_API_PREFIX=/api/admin/v1

# =============================================================================
# API Service 专属 [必填]
# =============================================================================
SERVICE_TYPE=api
PUBLIC_BASE_URL=https://YOUR_APP.zeabur.app
CORS_ALLOW_ORIGINS=https://YOUR_FRONTEND.zeabur.app

# =============================================================================
# Worker Service 专属 [必填]
# =============================================================================
SERVICE_TYPE=worker
# (不需要 PUBLIC_BASE_URL 和 CORS_ALLOW_ORIGINS)

# =============================================================================
# 安全配置 [建议 - API 和 Worker 都设置]
# =============================================================================
USER_JWT_SECRET=replace-with-strong-random-user-secret
ADMIN_JWT_SECRET=replace-with-strong-random-admin-secret
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=replace-with-admin-password
ALLOW_DEV_AUTH_BYPASS=false

# =============================================================================
# 图片 SaaS 配置 [必填 - API Service]
# =============================================================================
IMAGE_SAAS_DEFAULT_APP_ID=default
IMAGE_SAAS_APP_KEYS=["default:replace-with-prod-app-key"]

# =============================================================================
# AI 模型 API Keys [必填 - API 和 Worker 都需要]
# =============================================================================
WHATAI_API_BASE=https://api.aicodemirror.com
WHATAI_API_KEY=sk-your-key
IMAGE_API_BASE=https://www.aiartmirror.com
IMAGE_API_KEY=sk-your-key
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=sk-or-v1-your-key
DOUBAO_API_BASE=https://ark.cn-beijing.volces.com/api/v3
DOUBAO_API_KEY=your-key
ARK_API_KEY=your-key
DEEPSEEK_API_BASE=https://api.deepseek.com/v1
DEEPSEEK_API_KEY=sk-your-key
QWEN_API_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=sk-your-key

# =============================================================================
# LLM 路由配置 [可选 - 与代码默认值一致可省略]
# =============================================================================
LLM_PROVIDER=whatai
LLM_ROUTE_ANALYSIS=qwen_text
LLM_ROUTE_MAIN_PLANNER=deepseek_text
LLM_ROUTE_DETAIL_PLANNER=deepseek_text
LLM_ROUTE_PLANNER_LIGHT=whatai_gemini
LLM_ROUTE_PARAMETER_VISUAL=whatai_gemini
LLM_ROUTE_PARAMETER_COMPLETION=deepseek_text
LLM_ROUTE_MAIN_COPY_DESIGN=deepseek_text
LLM_ROUTE_DETAIL_COPY_REVIEW=disabled
LLM_ROUTE_TEXT_REVIEW=deepseek_text
PARAMETER_EXTRACTION_MODE=separate
PLANNER_FALLBACK_ROUTE=whatai_gemini
PLANNER_PROFILE=harness_first

# =============================================================================
# 存储配置 (S3 / 腾讯云 COS) [必填 - 两个 Service 都需要]
# =============================================================================
STORAGE_BACKEND=s3
S3_ENDPOINT=https://cos.ap-beijing.myqcloud.com
S3_REGION=ap-beijing
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY=your-access-key
S3_SECRET_KEY=your-secret-key

# =============================================================================
# 后台管理 [可选]
# =============================================================================
ADMIN_DATABASE_URL=sqlite:///./storage/admin.sqlite3

# =============================================================================
# 生成并发控制 [可选]
# =============================================================================
TASKS_EAGER=false
GENERATION_LOCK_TTL_SECONDS=600
MAIN_GENERATION_CONCURRENCY=4
DETAIL_GENERATION_CONCURRENCY=6
GENERATION_SUBMIT_CONCURRENCY=6
DETAIL_GENERATION_SUBMIT_CONCURRENCY=4
IMAGE_SUBMIT_BATCH_SIZE=5
IMAGE_POLL_INITIAL_DELAY_SECONDS=45
IMAGE_TASK_TIMEOUT_SECONDS=450

# =============================================================================
# 积分定价 [可选]
# =============================================================================
CREDIT_PRICING_RULES={"generate_gallery":{"credits":10,"description":"主图整组生成"},"generate_detail_page":{"credits":16,"description":"详情页整组生成"},"global_edit":{"credits":8,"description":"主图全局修改"},"regenerate_asset":{"credits":3,"description":"单张主图重生成"},"regenerate_detail_panel":{"credits":4,"description":"单张详情页 panel 重生成"},"regenerate_gallery":{"credits":10,"description":"主图整组重生成"}}
