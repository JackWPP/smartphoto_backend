APP_NAME=smartphoto-backend
APP_ENV=prod
API_PREFIX=/api/v2
ADMIN_API_PREFIX=/api/admin/v1
PUBLIC_BASE_URL=http://YOUR_SERVER_IP:8000
CORS_ALLOW_ORIGINS=http://YOUR_FRONTEND_HOST:5173
PIP_INDEX_URL=http://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple
PIP_TRUSTED_HOST=mirrors.tuna.tsinghua.edu.cn

POSTGRES_DB=smartphoto
POSTGRES_USER=smartphoto
POSTGRES_PASSWORD=change-this-postgres-password
DATABASE_URL=postgresql+psycopg://smartphoto:change-this-postgres-password@postgres:5432/smartphoto
REDIS_URL=redis://redis:6379/0

STORAGE_ROOT=./storage
ADMIN_DATABASE_URL=sqlite:///./storage/admin.sqlite3
STORAGE_BACKEND=s3
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=false
S3_SIGNED_URL_TTL_SECONDS=900
S3_PRESIGN_UPLOAD_TTL_SECONDS=900
S3_PREFIX_UPLOADS=uploads
S3_PREFIX_GENERATED=generated

TASKS_EAGER=false
ALLOW_DEV_AUTH_BYPASS=false
TEST_USER_ID=00000000-0000-0000-0000-000000000001
USER_JWT_SECRET=replace-with-strong-random-user-secret
USER_ACCESS_TOKEN_EXP_MINUTES=120
USER_REFRESH_TOKEN_EXP_DAYS=14
ADMIN_JWT_SECRET=replace-with-strong-random-admin-secret
ADMIN_ACCESS_TOKEN_EXP_MINUTES=120
ADMIN_REFRESH_TOKEN_EXP_DAYS=14

WHATAI_API_BASE=https://api.whatai.cc
WHATAI_API_KEY=
WHATAI_CHAT_MODEL=
WHATAI_ANALYSIS_MODEL=
WHATAI_PLANNER_MODEL=
WHATAI_IMAGE_MODEL=
WHATAI_PARAMETER_MODEL=
WHATAI_REQUEST_TIMEOUT_SECONDS=180
LLM_PROVIDER=openrouter
OPENROUTER_API_BASE=https://openrouter.ai/api/v1
OPENROUTER_API_KEY=
LLM_ANALYSIS_MODEL=moonshotai/kimi-k2.5
LLM_MAIN_PLANNER_MODEL=xiaomi/mimo-v2-pro
LLM_DETAIL_PLANNER_MODEL=minimax/minimax-m2.7
LLM_PARAMETER_MODEL=moonshotai/kimi-k2.5
LLM_FALLBACK_MODEL=xiaomi/mimo-v2-pro

GENERATION_LOCK_TTL_SECONDS=600
MAIN_GENERATION_CONCURRENCY=4
DETAIL_GENERATION_CONCURRENCY=6
GENERATION_SUBMIT_CONCURRENCY=6
IMAGE_TASK_TIMEOUT_SECONDS=450
IMAGE_POLL_PROFILE=[{"interval_seconds":5,"attempts":6},{"interval_seconds":10,"attempts":12},{"interval_seconds":15,"attempts":20}]
CREDIT_PRICING_RULES={"generate_gallery":{"credits":10,"description":"主图整组生成"},"generate_detail_page":{"credits":16,"description":"详情页整组生成"},"global_edit":{"credits":8,"description":"主图全局修改"},"regenerate_asset":{"credits":3,"description":"单张主图重生成"},"regenerate_detail_panel":{"credits":4,"description":"单张详情页 panel 重生成"},"regenerate_gallery":{"credits":10,"description":"主图整组重生成"}}
